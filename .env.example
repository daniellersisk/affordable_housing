APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_DB=affordable_housing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/affordable_housing

# DB hardening defaults (tune per deployment)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000

# NYC Open Data ingestion (SODA v2 resource endpoint).
# Prefer the V1_* names; the non-V1 names remain supported for backwards compatibility.
NYC_OPEN_DATA_V1_URL=
NYC_OPEN_DATA_V1_BASE_URL=https://data.cityofnewyork.us
NYC_OPEN_DATA_V1_VIEW_ID=hg8x-zxpr
SODA_APP_TOKEN=
INGEST_PAGE_SIZE=2000
INGEST_TIMEOUT_SECONDS=30
INGEST_MAX_RETRIES=3

API_AUTH_ENABLED=true
# Local-only API key for write routes.
# In production, set a strong random key via your secret manager.
WRITE_API_KEY=local-dev-key
WRITE_API_KEY_HEADER=X-API-Key
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
